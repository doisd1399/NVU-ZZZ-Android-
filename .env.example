# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Capacitor release source. The default is the production Netlify site.
# Set NVU_CAPACITOR_MODE=embedded only for an intentional offline/local APK.
NVU_NETLIFY_URL="https://stirring-pavlova-ca6808.netlify.app"
NVU_CAPACITOR_MODE="remote"
# Só habilite se a aplicação usar um domínio personalizado Netlify confiável.
NVU_ALLOW_CUSTOM_NETLIFY_DOMAIN="false"

# Compatibilidade gradual com a coleção legada `notificacoes`.
# Ausentes ou "true" preservam o comportamento atual. Não desative antes dos testes finais.
VITE_LEGACY_NOTIFICATIONS_READ_HISTORY="true"
VITE_LEGACY_NOTIFICATIONS_REALTIME="true"
VITE_LEGACY_NOTIFICATIONS_WRITE_FALLBACK="true"
VITE_LEGACY_NOTIFICATIONS_RESOLVE="true"
